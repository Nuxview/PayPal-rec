# Use credentials from a Sandbox app, never a live app.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Sandbox browser workspace key. Generate a random value, e.g. openssl rand -hex 32.
PAYPAL_SANDBOX_WEB_KEY=

# MongoDB case storage for the Sandbox browser workspace (Vercel or local).
MONGODB_URI=
MONGODB_DB=paypal_rec

# PostgreSQL CLI storage and existing local workspaces without MONGODB_URI.
DATABASE_URL=

# Public HTTPS origin for browser checkout outside localhost (no path or trailing query).
# Omit for localhost/127.0.0.1.
PAYPAL_SANDBOX_RETURN_ORIGIN=

# Evidence analysis uses one provider at a time: nvidia (default) or gemini.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Enable AI on the fixed, synthetic public case (can consume provider quota).
AI_PUBLIC_DEMO=false
