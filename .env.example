# Use credentials from a Sandbox app, never a live app.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Sandbox browser workspace key. Generate a random value, e.g. openssl rand -hex 32.
PAYPAL_SANDBOX_WEB_KEY=

# Needed for stored cases and the Sandbox browser workspace.
DATABASE_URL=

# Public HTTPS origin for browser checkout outside localhost (no path or trailing query).
# Omit for localhost/127.0.0.1.
PAYPAL_SANDBOX_RETURN_ORIGIN=
