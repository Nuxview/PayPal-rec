{
  "name": "paypal-rec",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "paypal:import": "node --env-file-if-exists=.env.local scripts/import-paypal.ts",
    "documents:import": "node --env-file-if-exists=.env.local scripts/import-documents.ts",
    "notice:capture": "node --env-file-if-exists=.env.local scripts/capture-notice.ts",
    "evidence:match": "node --env-file-if-exists=.env.local scripts/match-evidence.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "~5.9.3"
  }
}
